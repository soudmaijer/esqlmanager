root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 160
ij_java_class_brace_style = next_line
ij_java_method_brace_style = next_line
ij_java_lambda_brace_style = next_line
ij_java_brace_style = next_line
ij_java_else_on_new_line = true
ij_java_catch_on_new_line = true
ij_java_finally_on_new_line = true
ij_java_while_on_new_line = true
ij_java_space_within_method_call_parentheses = true
ij_java_space_within_method_parentheses = true
ij_java_space_within_if_parentheses = true
ij_java_space_within_for_parentheses = true
ij_java_space_within_while_parentheses = true
ij_java_space_within_switch_parentheses = true
ij_java_space_within_catch_parentheses = true
ij_java_space_within_try_parentheses = true
ij_java_wrap_long_lines = true
ij_java_imports_layout = *
ij_java_use_single_class_imports = true
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999

[*.{xml,md,yml,yaml,json}]
indent_style = space
indent_size = 2
